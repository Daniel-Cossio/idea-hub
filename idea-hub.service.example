[Unit]
Description=IdeaHub - Telegram Idea Capture & Web Manager
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Documentos/git/idea-hub
EnvironmentFile=/home/ubuntu/Documentos/git/idea-hub/.env.local
ExecStart=/home/ubuntu/Documentos/git/idea-hub/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8090 --workers 1
Restart=always
RestartSec=5
MemoryHigh=150M
MemoryMax=200M

[Install]
WantedBy=multi-user.target
